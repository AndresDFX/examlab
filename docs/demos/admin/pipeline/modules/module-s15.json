    {
      "id": "tarjeta",
      "kind": "platform",
      "narration": "En Proyectos, la tarjeta te avisa cuando la actividad se entrega en grupo y todavía no tienes uno: sin grupo no se puede entregar. Para armarlo, toca Armar grupo.",
      "bufferMs": 900,
      "beats": [
        {
          "target": "text:Esta actividad se entrega en grupo",
          "scale": 1.35,
          "hold": 5200,
          "side": "right",
          "syncWord": "avisa",
          "focus": {
            "title": "Sin grupo no se entrega",
            "body": "La actividad es grupal y todavía no tienes grupo."
          }
        },
        {
          "target": "button:Armar grupo",
          "click": true,
          "waitText": "Crear grupo",
          "waitTimeoutMs": 20000,
          "focusTarget": "[role=\"dialog\"]",
          "scale": 1,
          "hold": 1500,
          "side": "right",
          "syncWord": "toca",
          "focus": {
            "title": "Mi grupo",
            "body": "Aquí armas tu grupo."
