            "body": "Cambia entre Administrador, Docente y Estudiante."
          }
        },
        {
          "target": "[data-tour-id=\"notifications-bell\"]",
          "scale": 2.1,
          "hold": 3000,
          "side": "right",
          "overpan": true,
          "syncWord": "campana",
          "focus": {
