{
  "$schema": "node_modules/wrangler/config-schema.json",

  // El nombre ES la primera etiqueta de la URL: `app.examlab.workers.dev`.
  //
  // Se llama `app` y no `examlab` a propósito. Cada institución se publica como
  // un Worker aparte nombrado con su slug (`wrangler deploy --name uniaj` →
  // `uniaj.examlab.workers.dev`), y `subdomain.ts` lee esa primera etiqueta como
  // la institución. `app` está en su lista de etiquetas reservadas, así que ESTE
  // despliegue —el general— muestra el selector en vez de intentar resolver una
  // institución llamada "app".
  "name": "app",

  "compatibility_date": "2025-09-24",

  // ── Despliegue SOLO de assets: no hay `main`, no hay código de servidor ───
  //
  // A propósito. El Worker SSR pesaba 5,34 MB gzip y el plan Free corta en
  // 3 MB (error 10027 al desplegar). Acá no se sube Worker: se suben los
  // archivos que el modo SPA prerenderizó, y Cloudflare los sirve como sitio
  // estático. Sin código de servidor, ni el límite de tamaño ni el de 10 ms de
  // CPU aplican.
  //
  // `single-page-application` es imprescindible: sin eso, entrar directo a
  // `/app/teacher/exams` daría 404, porque en el disco no existe ese archivo —
  // es una ruta del router de la app. Con esto, cualquier ruta desconocida
  // devuelve index.html y el router del navegador resuelve.
  //
  // index.html lo produce `scripts/build-cloudflare.mjs` copiando el
  // `_shell.html` del prerender, que es el nombre que TanStack Start le da.
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
  },

  // ── Subdominio por institución (fase 2, cuando exista el dominio) ──────────
  //
  // Para que `uniaj.tudominio.co` entre directo a esa institución hace falta un
  // Route CON COMODÍN. Tiene que ser `routes`, NO `custom_domain`: la doc de
  // Cloudflare dice textual que los Custom Domains "do not support wildcard DNS
  // records". Además, en el panel de DNS debe existir `A · * · 192.0.2.1` con la
  // nube NARANJA (proxied) — con la nube gris el Worker nunca se ejecuta.
  //
  // Universal SSL (plan Free) cubre un solo nivel: `uniaj.tudominio.co` sí,
  // `sede.uniaj.tudominio.co` no.
  //
  // Descomentar y reemplazar el dominio:
  //
  // "routes": [
  //   { "pattern": "*.tudominio.co/*", "zone_name": "tudominio.co" },
  //   { "pattern": "tudominio.co/*", "zone_name": "tudominio.co" },
  // ],
}
